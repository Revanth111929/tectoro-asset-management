# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and configure for your environment
# NEVER commit .env to git - it contains sensitive data

# ==========================================
# ENVIRONMENT TYPE
# ==========================================
# Options: development, production
# Default: development
FLASK_ENV=development

# ==========================================
# DATABASE CONFIGURATION (REQUIRED)
# ==========================================
# APP_ENV selects the database and MUST be set to exactly one of:
#   office  -> uses office_assets.db  (local office application, real data)
#   render  -> uses demo_assets.db    (public Render deployment, demo data)
# There is no default and no fallback between the two — the app refuses to
# start if APP_ENV is missing/invalid, or if DATABASE_URL contradicts it.
APP_ENV=office

# Option 1: Let the app auto-select the SQLite file based on APP_ENV above
# (recommended — leave DATABASE_URL unset).

# Option 2: Use DATABASE_URL to point at an external database (e.g. Postgres)
# instead of the local SQLite file. It must still match APP_ENV — e.g. a
# 'render' environment's DATABASE_URL must never reference office_assets.db.
# DATABASE_URL=postgresql://user:password@localhost/dbname

# ==========================================
# SECURITY
# ==========================================
# Flask Secret Key (REQUIRED - CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-this-in-production-use-random-string

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
# For asset assignment notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@company.com

# For Gmail: Enable 2FA and create an App Password
# https://support.google.com/accounts/answer/185833
