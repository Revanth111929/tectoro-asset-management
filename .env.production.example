# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
# This is the PRODUCTION configuration template
# Copy this to .env on production server
# CRITICAL: Seed data is DISABLED in production

# ==========================================
# ENVIRONMENT TYPE (REQUIRED)
# ==========================================
FLASK_ENV=production

# ==========================================
# DATABASE CONFIGURATION (REQUIRED)
# ==========================================
# Production MUST use a persistent database service
# 
# For Render PostgreSQL (RECOMMENDED):
# DATABASE_URL=postgresql://user:password@host:5432/database
#
# For other PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# WARNING: Do NOT use SQLite in production on Render
# Render's ephemeral storage will lose all data on redeploy
DATABASE_URL=your-database-url-here

# ==========================================
# SECURITY (CRITICAL - MUST CHANGE)
# ==========================================
# Generate a strong secret key:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-TO-RANDOM-64-CHARACTER-STRING

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
MAIL_SERVER=smtp.company.com
MAIL_PORT=587
MAIL_USERNAME=assets@company.com
MAIL_PASSWORD=your-secure-app-password
MAIL_DEFAULT_SENDER=assets@company.com

# ==========================================
# PRODUCTION SAFETY NOTES
# ==========================================
# 1. FLASK_ENV=production disables seed_data()
# 2. DATABASE_URL must point to persistent database
# 3. Never use development SQLite in production
# 4. Render PostgreSQL addon recommended
# 5. Backup production database regularly
# 6. Never commit .env to git
# 7. Use strong SECRET_KEY (64+ characters)
# 8. Restrict file permissions: chmod 600 .env
